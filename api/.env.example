# Porta HTTP da API
PORT=3001

# Banco (local: docker compose up -d). Em produção, a URL do Neon com ?sslmode=require
DATABASE_URL=postgresql://vitrine:vitrine@localhost:5440/vitrine

# JWT do painel
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Cloudinary (painel do Cloudinary > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Pasta onde as fotos ficam no Cloudinary (use uma por cliente/demo)
CLOUDINARY_FOLDER=vitrine

# Revalidação do cache do Next (mesmo segredo configurado na web)
WEB_URL=http://localhost:3000
REVALIDATE_SECRET=troque-este-segredo

# Limite de leads por IP: LEADS_LIMITE envios a cada LEADS_JANELA_SEGUNDOS
LEADS_LIMITE=5
LEADS_JANELA_SEGUNDOS=600

# Usuário do painel criado pelo seed
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=demo1234
