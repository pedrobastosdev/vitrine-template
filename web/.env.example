# URL pública da API NestJS (usada pelo servidor do Next e pelo formulário de contato)
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL pública deste site (links canônicos, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mesmo valor de REVALIDATE_SECRET da API
REVALIDATE_SECRET=troque-este-segredo
